 {
  "custom_department": "Service Delivery - NTPL",
  "description": "Project initiation is the first phase of the project management lifecycle, where a project's feasibility and value are assessed. This phase involves defining the project's purpose, scope, objectives, stakeholders, and expected outcomes. Key activities include developing a business case, conducting a feasibility study, identifying risks, and preparing a project charter. Approval from stakeholders or sponsors is typically required before moving forward. Successful initiation ensures that the project aligns with organizational goals and provides a clear foundation for planning and execution. It sets the direction, assigns responsibilities, and establishes a shared understanding among all involved parties.",
  "docstatus": 0,
  "doctype": "Task Type",
  "modified": "2025-05-03 10:34:55.071990",
  "name": "Project Initiaition",
  "weight": 10.0
 },
 {
  "custom_department": "Service Delivery - NTPL",
  "description": "ISP (Internet Service Provider) ordering is the process of selecting, requesting, and provisioning internet services for an organization or individual. It begins with identifying connectivity requirements such as bandwidth, speed, service type (fiber, DSL, wireless), and location. The ordering phase includes evaluating available ISPs, comparing service plans, negotiating terms, and submitting a formal service request. Once the order is placed, the ISP schedules installation, configures the service, and activates the connection. Proper documentation and confirmation of service-level agreements (SLAs) are essential. This process ensures reliable internet access tailored to specific user needs, supporting communication, operations, and digital activities.",
  "docstatus": 0,
  "doctype": "Task Type",
  "modified": "2025-05-03 10:36:16.371643",
  "name": "ISP Ordering",
  "weight": 10.0
 },
