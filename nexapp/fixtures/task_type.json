 {
  "custom_department": "Service Delivery - NTPL",
  "description": "Link and hardware delivery involves the provision and setup of physical equipment and connectivity required for internet or network services. This process begins after service ordering and includes the delivery of necessary hardware such as routers, modems, switches, or firewalls, along with the establishment of the communication link (fiber, DSL, wireless, etc.). Coordination between the ISP, vendors, and the client is crucial to ensure timely and accurate delivery. Technicians may be dispatched for installation and testing. Proper configuration, documentation, and verification are performed to ensure the link is active and hardware functions as intended, enabling reliable and secure network access.",
  "docstatus": 0,
  "doctype": "Task Type",
  "modified": "2025-05-03 10:39:32.104076",
  "name": "Link & Hardware Delivery",
  "weight": 15.0
 },
 {
  "custom_department": "Service Delivery - NTPL",
  "description": "Final handover and project closure mark the completion of a project, ensuring all deliverables have been met and formally transferred to the client or end users. This phase includes verifying that project objectives are achieved, conducting final testing, obtaining stakeholder approvals, and delivering documentation such as user manuals, configuration details, and training materials. Any outstanding issues are resolved, and a lessons learned session is conducted to capture insights for future projects. Administrative tasks like releasing resources, closing contracts, and archiving records are completed. The project is officially closed with a sign-off, confirming that responsibilities have been successfully transitioned and goals fulfilled.",
  "docstatus": 0,
  "doctype": "Task Type",
  "modified": "2025-05-03 10:47:55.979876",
  "name": "Handover to NOC",
  "weight": 2.0
 },
