 {
  "custom_department": "Service Delivery - NTPL",
  "description": "Last mile network connectivity deployment focuses on establishing the final link between the service provider’s network and the end user. It involves installing and configuring routers, modems, and related networking devices at customer premises. Technicians ensure proper physical setup, secure cabling, and power connections. The router is configured with necessary WAN settings, firewall rules, and wireless parameters. Signal strength, data throughput, and connectivity stability are tested. This phase ensures reliable internet access and seamless integration with upstream networks. Documentation and user guidance are provided upon completion, marking the successful commissioning of last mile connectivity for residential, commercial, or enterprise environments.\n",
  "docstatus": 0,
  "doctype": "Task Type",
  "modified": "2025-05-02 18:40:47.552093",
  "name": "Installation & Commisioning",
  "weight": 16.0
 },
